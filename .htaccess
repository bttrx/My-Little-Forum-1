## Enable PHP version 7.3
##  (Sometimes useful for testing.)
#AddHandler af_php73 .php

## Load php*.ini from that directory
##  (Sometimes useful for testing.)
#SetEnv PHPRC /home/www/doc/6631/bttr-software.de/www/forum

## Deny access to .htaccess, _htaccess, db_settings.php, INSTALL, LICENSE, or
##  README files. After installing or updating 'my little forum' you may also
##  want to add 'install\.php' below instead of deleting that file.
<Files ~ "^([\._]htaccess|db_settings\.php|install\.php|INSTALL|LICENSE|README)$">
    <IfModule mod_authz_host>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_host>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>


# MLF performance defaults (Apache only; configure equivalent settings on nginx).
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType image/gif "access plus 7 days"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType image/x-icon "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?i:css|js|gif|jpe?g|png|svg|ico)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>
